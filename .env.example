# Puerto del API Node (SQLite). Por defecto 3011 en este proyecto.
# En Windows, WSL a veces ocupa el 3010 (wslrelay) y el login falla si el API sigue en 3010.
INVENTARIO_API_PORT=3011

# Opcional: URL explícita para el frontend (Tauri / build). Si no se define, usa http://127.0.0.1:3011
# VITE_API_URL=http://127.0.0.1:3011
# VITE_API_PORT=3011

# Secreto JWT (obligatorio en producción)
# JWT_SECRET=cambiar-en-produccion
